programa {
  //[3][3] - Crie uma matriz de inteiros com 3 linhas e 3 colunas.
  inteiro numeros[3][3]

  funcao inicio() {

  numeros[0][0] = 10
  numeros[0][1] = 20
  numeros[0][2] = 30

  numeros[1][0] = 40
  numeros[1][1] = 50
  numeros[1][2] = 60

  numeros[2][0] = 70
  numeros[2][1] = 80
  numeros[2][2] = 90

  escreva(numeros[1][1])

    
  }
}
