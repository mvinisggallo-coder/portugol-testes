
programa
{
    inteiro opcao = 0

    funcao inicio()
    {
        enquanto (opcao != 6)
        {
            escreva("\n=== Assistência Técnica ===\n")
            escreva("1 - Clientes\n")
            escreva("2 - Produtos\n")
            escreva("3 - Equipamentos\n")
            escreva("4 - Orçamentos\n")
            escreva("5 - Serviços\n")
            escreva("6 - Sair\n")

            escreva("Digite uma opção: ")
            leia(opcao)
        }

        escreva("\nVocê saiu do Menu!")
    }
}

