programa {
  funcao inteiro somar(inteiro a, inteiro b) {
    retorne a + b
  }


  funcao inicio() {
    inteiro resultado, a, b
    escreva("\nDigite um número: ")
    leia(a)
    escreva("\nDigite outro número: ")
    leia(b)


    resultado = somar(a,b)
    escreva("Resultado = ", resultado)

  
    
  }
}
