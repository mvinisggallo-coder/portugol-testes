programa {
  funcao numeroMaior(inteiro a, inteiro b){
  se (a > b) {
    escreva("Maior Número = ",a)
  }
  senao {
    escreva("Maior Número = ",b)
  }

}
  funcao inicio() {
    inteiro a,b
  escreva("Digite o primeiro número: ")
  leia(a)
  escreva("Digite o segundo número: ")
  leia(b)

  numeroMaior(a,b)
    
  }

    
    
  }
}
