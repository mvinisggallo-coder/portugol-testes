// VETORES
programa {
  inteiro numeros[6] // O VETOR TERÁ 6 POSIÇÕES [][][][][][]

  funcao inicio() {
  numeros[0] = 10
  numeros[1] = 20
  numeros[2] = 30
  numeros[3] = 40
  numeros[4] = 50
  //AGORA FORAM ATIBUÍDOS VALORES A CADA POSIÇÃO
  /*Índice: 0    1    2    3    4
            ↓    ↓    ↓    ↓    ↓
    Valor: 10   20   30   40   50 */
    escreva(numeros[4])
    
  }
}
