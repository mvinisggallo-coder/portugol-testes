//queremos pedir 5 números ao usuário.//
programa {
  inteiro numeros[5]
  funcao inicio() {
//Será criada uma variável contadora i//
para (inteiro i =0; i <5; i++){
  escreva("Digite um número: ")
  leia(numeros[i])
}
//Mostrará o número que foi preenchido na 3ª Posição do vetor.//
escreva(numeros[2])
    
  }
}
